---
import { Picture } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import taskifyImage from "@/assets/taskify-home.png";

const heroLetters = [..."effortless"];

const experience = [
  {
    title: "Full Stack Developer",
    company: "iad México",
    period: "Oct 2024 — Present",
    details: [
      "Developed a deal closing system that streamlines transactions and portfolio management for brokers.",
      "Co-implemented AI powered image validation and property descriptions to support listing quality.",
    ],
  },
  {
    title: "Senior Frontend Engineer",
    company: "iad México",
    period: "Jul 2018 — Oct 2024",
    details: [
      "Built the core internal call center platform and co-developed AI agent integrations for support workflows.",
      "Improved public page SEO and performance with Astro, and built backoffice tools and a React Native app.",
    ],
  },
];
---

<Layout>
  <header class="site-header shell">
    <a class="brand" href="#top" aria-label="Angel Vasquez, back to top">
      AV<span class="brand-dot">.</span>
    </a>
    <nav aria-label="Main navigation">
      <a href="#work">Work</a>
      <a href="#experience">Experience</a>
      <a href="#about">About</a>
      <a href="https://github.com/angelitodev" target="_blank" rel="noopener noreferrer">GitHub</a>
    </nav>
    <a class="header-contact" href="mailto:angelito.the.dev@gmail.com">
      Let's talk <span aria-hidden="true">↗</span></a>
  </header>

  <main id="main">
    <section class="hero shell" id="top" aria-labelledby="hero-title">
      <div class="hero-topline">
        <span class="status-dot" aria-hidden="true"></span> Senior software engineer
        · Mexico City
      </div>
      <h1 id="hero-title">
        Building digital<br /><span>things that feel</span><br />
        <span class="hero-word" aria-hidden="true">
          {
            heroLetters.map((letter, index) => (
              <span class="hero-letter" style={`--letter-index: ${index}`}>
                {letter}
              </span>
            ))
          }
        </span><span class="sr-only">effortless</span><span class="hero-period">.</span
        >
      </h1>
      <div class="hero-bottom">
        <p>
          I'm Angel Vasquez. I build useful products and practical AI tools,
          shaped by eight years in software and a background in psychology.
        </p>
        <a class="text-link" href="#work">Explore my work <span aria-hidden="true">↘</span></a>
      </div>
    </section>

    <section class="work-section" id="work" aria-labelledby="work-title">
      <div class="shell">
        <div class="section-heading">
          <p class="section-index">01 / Selected work</p>
          <h2 id="work-title">
            <span data-motion="line">Thoughtful technology.</span>{" "}<span
              data-motion="line"
              data-from="right">Real utility.</span>
          </h2>
        </div>
        <article class="project">
          <a
            class="project-image-wrap"
            href="https://www.youtube.com/watch?v=-8gFCtiwjQA"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Watch the Taskify demo"
          >
            <Picture
              src={taskifyImage}
              formats={["avif", "webp"]}
              fallbackFormat="png"
              widths={[480, 800, 1200, 1600]}
              sizes="(max-width: 700px) 100vw, 75vw"
              alt="Taskify sign-in screen showing its company knowledge assistant"
              loading="lazy"
              class="project-image"
              data-motion="image"
            />
          </a>
          <div class="project-info" data-motion="detail">
            <div>
              <p class="project-kind">
                Personal project / AI knowledge assistant
              </p>
              <h3>Taskify<span class="project-period">.</span></h3>
            </div>
            <div class="project-description">
              <p>
                Taskify uses AI to answer employees' questions from company
                documents, with citations to the original sources.
                Administrators manage company knowledge, while conversations
                stay private to each account.
              </p>
              <p class="project-repo-note">
                The repository includes architecture diagrams and graphs showing
                how the AI system works.
              </p>
              <div class="project-links">
                <a
                  class="project-link"
                  href="https://www.youtube.com/watch?v=-8gFCtiwjQA"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Watch the demo <span aria-hidden="true">↗</span>
                </a>
                <a
                  class="project-link"
                  href="https://github.com/angelitodev/taskify/"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  View code and architecture <span aria-hidden="true">↗</span>
                </a>
              </div>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section
      class="experience-section shell"
      id="experience"
      aria-labelledby="experience-title"
    >
      <div class="section-heading split-heading">
        <p class="section-index">02 / Experience</p>
        <h2 id="experience-title">
          <span data-motion="line">Eight years of</span>{" "}<span
            data-motion="line"
            data-from="right">making things work.</span>
        </h2>
      </div>
      <div class="experience-list">
        {
          experience.map((role) => (
            <article class="role" data-motion="role">
              <div class="role-date">{role.period}</div>
              <div class="role-content">
                <h3>{role.title}</h3>
                <p class="role-company">{role.company} · Mexico City</p>
                <ul>
                  {role.details.map((detail) => (
                    <li>{detail}</li>
                  ))}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="about-section" id="about" aria-labelledby="about-title">
      <div class="shell about-grid">
        <div>
          <p class="section-index">03 / About</p>
          <h2 id="about-title">
            <span data-motion="line">Engineering with</span>{" "}<span
              data-motion="line"
              data-from="right">people in mind.</span>
          </h2>
        </div>
        <div class="about-copy" data-motion="detail">
          <p>
            My work sits at the intersection of product thinking, engineering,
            and AI. I specialize in the JavaScript ecosystem, with growing
            experience in Python and Django backend architecture. My psychology
            background keeps the human side of every interface in focus.
          </p>
          <div class="about-detail">
            <h3>Focus</h3>
            <p>
              React, Next.js, TypeScript, Astro, Node.js, Python, Django,
              AI agents, LangChain, AWS
            </p>
          </div>
          <div class="about-detail">
            <h3>Learning</h3>
            <p>
              Artificial Intelligence Engineering · University of the Valley of
              Mexico, 2026-present
            </p>
            <p>
              Psychology · National Autonomous University of Mexico, 2011-2015
            </p>
          </div>
          <div class="about-detail">
            <h3>Certifications</h3>
            <a
              href="https://certs.langchain.com/a15a6841-9d74-4b5c-bf7a-caa9211a31e3"
              target="_blank"
              rel="noopener noreferrer"
              >LangChain Certified Agent Engineer <span aria-hidden="true"
                >↗</span
              ></a
            >
            <a
              href="https://coursera.org/share/383a26516b7834c86248ef7a70e4734b"
              target="_blank"
              rel="noopener noreferrer"
              >AI Agent Developer Specialization <span aria-hidden="true"
                >↗</span
              ></a
            >
          </div>
          <p class="languages">Native Spanish · Intermediate English</p>
        </div>
      </div>
    </section>

    <section class="contact-section shell" aria-labelledby="contact-title">
      <p class="section-index">04 / Contact</p>
      <h2 id="contact-title">
        <span data-motion="line">Have something</span>{" "}<span
          data-motion="line"
          data-from="right">in mind<span>?</span></span>
      </h2>
      <a
        class="contact-email"
        data-motion="detail"
        href="mailto:angelito.the.dev@gmail.com"
        >Let's make it happen <span aria-hidden="true">↗</span></a
      >
    </section>
  </main>

  <footer class="site-footer shell">
    <span>© {new Date().getFullYear()} Angel Vasquez</span>
    <div>
      <a href="mailto:angelito.the.dev@gmail.com">Email</a><a
        href="https://github.com/angelitodev"
        target="_blank"
        rel="noopener noreferrer">GitHub ↗</a>
    </div>
    <span>Made with care in Mexico City.</span>
  </footer>

  <script>
    import "@/scripts/motion";
  </script>
</Layout>
